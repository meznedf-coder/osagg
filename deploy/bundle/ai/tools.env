# superset_tools_mcp.py (service superset-tools) - chmod 600, it holds a password
SUPERSET_CONFIG_PATH=/etc/superset/superset_config.py
FLASK_APP=superset
PYTHONUNBUFFERED=1
TOOLS_USER=mcp_agent                           # Superset user the tools act as (its permissions)
CATALOG=/opt/superset/ai/catalog.yaml          # data dictionary
EXPORT_DIR=/srv/superset-exports               # Excel files and images
# EXPORT_BASE_URL=https://files.example.com/superset-exports   # if EXPORT_DIR is served
EXPORT_MAX_ROWS=500000                         # rows per extract (Excel: 1,048,575 per sheet)
EXPORT_KEEP_DAYS=7                             # files older than this are deleted
# EXPORT_DATABASES=OpenSearch (osagg)      # databases the tools may query (default: any the user may read)
# EMAIL_ALLOWED_DOMAINS=example.com            # e-mail recipients allowed (default: any)
EMAIL_MAX_ATTACH_MB=15
# REST API, for the scheduled reports (same user)
SUPERSET_URL=http://127.0.0.1:8088
SUPERSET_USER=mcp_agent
SUPERSET_PASSWORD=change-me
