# AI agent (superset_agent.py) - chmod 600, it holds a password
LLM_URL=http://127.0.0.1:8080/v1           # OpenAI-compatible LLM (llama.cpp --jinja, vLLM, ...)
# LLM_MODEL=                                   # default: the server's first model
# LLM_API_KEY=
MCP_URL=http://127.0.0.1:5008/mcp,http://127.0.0.1:5009/mcp   # Superset's MCP service + the tools service
# tools the model sees (a small model does better with a short list; * = all)
# AGENT_TOOLS=...                              # default: the useful tools of both services + show_chart
AGENT_THINKING=0                               # 1: reasoning tokens (slower on small GPUs)
AGENT_MAX_STEPS=16
# AGENT_NOW=2026-09-24 23:30                   # a fixed "now" for demos / replays on a copy of old data
# Superset REST API, for the agent's chart fixes (same user as MCP_DEV_USERNAME)
SUPERSET_URL=http://127.0.0.1:8088
SUPERSET_USER=mcp_agent
SUPERSET_PASSWORD=change-me
